# Скопіюйте у .env поруч із docker-compose.yml. Реальні секрети не комітьте.
# JWT має бути довшим за 32 символи.
JWT_SECRET=eger-dev-only-change-me-please-32b!

# Токен бота від @BotFather. Без нього канал Telegram не надішле код.
# Канал пошти від цього токена не залежить.
TELEGRAM_BOT_TOKEN=

# Локальна пошта: у Compose порожні значення лишають Mailpit (SMTP 1025, інтерфейс 8025).
# SMTP_HOST порожній поза Compose означає, що надсилання на пошту не налаштовано.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SEED_ADMIN_EMAIL=admin@eger.ua
SEED_ADMIN_PASSWORD=Admin123!
